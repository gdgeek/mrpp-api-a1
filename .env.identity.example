# Leave ownership in legacy mode until reviewed account/session import is complete.
IDENTITY_DATA_SOURCE=legacy
IDENTITY_INDEPENDENT_READY=false
IDENTITY_AUTH_BASE_URL=
IDENTITY_AUTH_TIMEOUT_MS=1500
# Auth-scoped and IAM-scoped keys belong only in the server/container secret environment.
# Empty scoped keys use IDENTITY_INTERNAL_API_TOKEN. Never expose these to browsers.
IDENTITY_TOKEN_ISSUANCE_INTERNAL_API_TOKEN=
IDENTITY_ACCOUNT_INTERNAL_TOKEN=
IDENTITY_IAM_INTERNAL_API_TOKEN=
IDENTITY_INTERNAL_API_TOKEN=
